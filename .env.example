# Trifecta Command Center — environment variables
#
# Copy to .env.local for local dev. In production set these in the Vercel project.
# If DATABASE_URL is unset, the app runs on an in-memory PGlite database that is
# auto-migrated and auto-seeded — handy for local dev, but data is NOT persisted.

# Neon Postgres connection string (use the pooled host). Required in production.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Enables the Claude natural-language fallback for Hermes. Optional:
# if unset, Hermes still answers all deterministic commands and degrades
# gracefully to its built-in help text for free-form questions.
ANTHROPIC_API_KEY=

# Model for the Hermes fallback. Defaults to claude-opus-4-8.
# Set to claude-sonnet-4-6 or claude-haiku-4-5 to lower cost.
ANTHROPIC_MODEL=claude-opus-4-8
