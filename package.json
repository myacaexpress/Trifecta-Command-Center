{
  "name": "trifecta-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "api": "tsx server/index.ts",
    "dev:all": "concurrently \"npm run api\" \"npm run dev\"",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "imessage:poll": "tsx server/imessage-daemon.ts",
    "test": "node --import tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "tsx": "^4.22.4"
  }
}
